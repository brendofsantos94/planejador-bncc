{
  "name": "planejador-bncc",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "pnpm@12.8.2",
  "engines": { "node": ">=22.12.0 <25" },
  "scripts": {
    "dev": "pnpm --parallel --filter @planejador/api --filter @planejador/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @planejador/api test:integration",
    "build": "pnpm -r build",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
